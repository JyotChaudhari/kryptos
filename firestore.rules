rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /artifacts/{appId}/public/data/users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /artifacts/{appId}/public/data/chat/{messageId} {
      allow read, create: if signedIn();
      allow update, delete: if signedIn() && request.auth.uid == resource.data.authorId;
    }

    match /artifacts/{appId}/public/data/posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }
  }
}
